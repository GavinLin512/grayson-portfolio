# Copy this file to .env and fill in your values.
# .env is git-ignored; .env.example is tracked as the schema reference.
# Future changes will append variables here as new features are added.

# add-contact-form
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NUXT_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NUXT_RESEND_API_KEY=re_xxxx
NUXT_PUBLIC_CONTACT_EMAIL=your@email.com

# add-guestbook-feature
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
NUXT_SESSION_PASSWORD=
